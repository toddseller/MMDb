# Database Configuration
DATABASE_URL=postgres://username:password@localhost:5432/mmdb_production
POSTGRES_DB=mmdb_production
POSTGRES_USER=your_db_username
POSTGRES_PASSWORD=your_secure_db_password

# Session Configuration (MUST be at least 64 characters for Rack 3)
# Generate with: ruby -rsecurerandom -e 'puts SecureRandom.hex(64)'
SESSION_SECRET=your_very_long_and_secure_session_secret_that_is_at_least_64_bytes_long_change_this

# JWT Configuration
# Generate with: ruby -rsecurerandom -e 'puts SecureRandom.hex(64)'
JWT_SECRET=your_jwt_secret_at_least_64_characters_long_change_this_to_something_secure
JWT_ISSUER=mmdb.yourdomain.com

# TMDB (The Movie Database) API
# Get your keys at: https://www.themoviedb.org/settings/api
TMDB_KEY=your_tmdb_api_key_here
TMDB_TOKEN=your_tmdb_bearer_token_here

# TVDB (TheTVDB) API v4
# Get your keys at: https://thetvdb.com/api-information
TVDB_APIKEY=your_tvdb_api_key_here
TVDB_PIN=your_tvdb_pin_here
TVDB_USERNAME=your_tvdb_username
TVDB_USERKEY=your_tvdb_user_key
TVDB_TOKEN=your_tvdb_jwt_token_will_auto_refresh

# Tautulli Integration (optional)
# Get from Tautulli Settings > Web Interface > API Key
TAUTULLI_KEY=your_tautulli_api_key_here

# Plex Configuration (optional)
PLEX_USER=your_plex_username
PLEX_USER_ID=1
LIBRARY_KEY=1

# Redis (optional)
REDISTOGO_URL=redis://localhost:6379/

# Heroku (if deploying to Heroku)
HEROKU_KEY=your_heroku_api_key_here

# Puma Configuration
WEB_CONCURRENCY=2
PUMA_THREADS=5
PORT=4666
