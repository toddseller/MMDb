{
  // Type-checks the JavaScript modules from their JSDoc; nothing is compiled, browsers get the files as written.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // Resolves #mmdb/* through package.json "imports", as Node does; the browser's import map maps the same names.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"]
  },
  "include": ["public/js/main.js", "public/js/mmdb/**/*", "spec/js/**/*.js"]
}
