#!/usr/bin/env ruby
# One-off repair of producers that hold a movie's rating; the logic and its specs live in ProducerRepair.
require_relative '../config/environment'

# Output goes to a log file on the server, where Ruby would otherwise hold the progress lines until the end.
$stdout.sync = true

command, path = ARGV
abort 'usage: bin/repair-producers plan|apply <report.csv>' unless %w[plan apply].include?(command) && path && ARGV.size == 2

command == 'plan' ? ProducerRepair.write_plan(path) : ProducerRepair.apply_file(path)
