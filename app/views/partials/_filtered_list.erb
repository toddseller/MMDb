<% @my_movies.each do |movie| %>
  <div class="index-preview text-center" data-letter="<%= RailLetter.of(movie.sort_name) %>" id="<%="#{user.id}"%>">
    <% if movie.isnew %>
      <div class="new-label"><span class="new-text">New</span></div>
    <% end %>
    <a class="movie-modal" id="<%="#{movie.id}"%>"><img src="<%= movie.thumbnail %>" loading="lazy" alt='<%="#{movie.title}" %> Poster' width='174' height='261' class='list-poster'></a>
    <p class="truncate"><%= movie.title %></p>
    <div class="pointer"></div>
    </div>
  </div>
<% end %>
