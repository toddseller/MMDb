<div class="modal-header">
  <button type="button" class="close" data-close aria-label="Close"><span aria-hidden="true">&times;</span></button>
  <h4 class="modal-title">Update Profile</h4>
</div>
<div class="modal-body">
  <p class="login-errors text-center">Couldn't save. Check your current password, email and user name, and that a new password has at least 8 characters.</p>
  <div class="row">
    <form class="login-form" action="<%="/users/#{user.id}"%>" method="post">
      <input type="hidden" name="_method" value="PUT">
      <div class="form-group col-sm-12">
        <label for="settings-first-name">First Name:</label>
        <input id="settings-first-name" class="form-control" type="text" name="first_name" autocomplete="given-name" value="<%="#{user.first_name}"%>">
      </div>
      <div class="form-group col-sm-12">
        <label for="settings-last-name">Last Name:</label>
        <input id="settings-last-name" class="form-control" type="text" name="last_name" autocomplete="family-name" value="<%="#{user.last_name}"%>">
      </div>
      <div class="form-group col-sm-12">
        <label for="settings-user-name">User name:</label>
        <input id="settings-user-name" class="form-control" type="text" name="user_name" autocomplete="username" value="<%="#{user.user_name}"%>">
      </div>
      <div class="form-group col-sm-12">
        <label for="settings-email">Email:</label>
        <input id="settings-email" class="form-control" type="email" name="email" autocomplete="email" value="<%="#{user.email}"%>">
      </div>
      <div class="form-group col-sm-12">
        <label id="theme-label">Theme:</label>
        <div class="btn-group theme-choice" data-toggle="buttons" role="radiogroup" aria-labelledby="theme-label">
          <% { 'default' => 'Light', 'dark' => 'Dark', 'system' => 'System' }.each do |value, name| %>
            <label class="btn btn-default"><input type="radio" name="theme" value="<%= value %>"<% if user.theme == value %> checked<% end %>> <%= name %></label>
          <% end %>
        </div>
      </div>
      <div id="current" class="form-group col-sm-12">
        <label for="settings-current">Current Password:</label>
        <input id="settings-current" class="form-control" type="password" name="current" autocomplete="current-password" placeholder="Only needed to change your password">
      </div>
      <div class="col-sm-12" id="no-match"></div>
      <div class="form-group col-sm-6 confirmation">
        <label for="settings-password">New Password:</label>
        <input id="settings-password" class="form-control" type="password" name="password" disabled="disabled" autocomplete="new-password" placeholder="At least 8 characters">
        <span class="glyphicon glyphicon-ok-sign"></span>
      </div>
      <div id="confirm" class="form-group col-sm-6 confirmation">
        <label for="settings-confirm">Confirm Password:</label>
        <input id="settings-confirm" class="form-control" type="password" name="confirm" disabled="disabled" autocomplete="new-password" placeholder="Confirm Password">
        <span class="glyphicon glyphicon-ok-sign"></span>
      </div>
      <div class="modal-footer col-sm-12">
        <button id="update-submit" type="submit" class="btn btn-danger">Update</button>
      </div>
    </form>
  </div>
</div>