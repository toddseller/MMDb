<div class="container registration">
  <div class="row">
    <h1 class="text-center">Sign Up Now!</h1>
    <p class="text-center">Please fill in the following information.</p>

    <form class="login-form" action="/users" method="post">
      <p class="errors">
        <% if params[:errors] != nil %>
        Oops! <%=params[:errors] %>
        <% end %>
      </p>
      <div class="form-group col-sm-12">
        <label for="register-first-name">First Name:</label>
        <input id="register-first-name" class="form-control" type="text" name="user[first_name]" autocomplete="given-name" placeholder="John">
      </div>
      <div class="form-group col-sm-12">
        <label for="register-last-name">Last Name:</label>
        <input id="register-last-name" class="form-control" type="text" name="user[last_name]" autocomplete="family-name" placeholder="Doe">
      </div>
      <div class="form-group col-sm-12">
        <label for="register-user-name">User name:</label>
        <input id="register-user-name" class="form-control" type="text" name="user[user_name]" autocomplete="username" placeholder="jonnyD">
      </div>
      <div class="form-group col-sm-12">
        <label for="register-email">Email:</label>
        <input id="register-email" class="form-control" type="email" name="user[email]" autocomplete="email" placeholder="john.doe@example.com">
      </div>
      <div class="col-sm-12" id="no-match2"></div>
      <div class="form-group col-sm-6 confirmation">
        <label for="register-password">Password:</label>
        <input id="register-password" class="form-control" type="password" name="user[password]" autocomplete="new-password" placeholder="At least 8 characters">
        <span class="glyphicon glyphicon-ok-sign"></span>
      </div>
      <div id="confirm" class="form-group col-sm-6 confirmation">
        <label for="register-confirm">Confirm Password:</label>
        <input id="register-confirm" class="form-control" type="password" name="confirm" autocomplete="new-password" placeholder="Confirm Password">
        <span class="glyphicon glyphicon-ok-sign"></span>
      </div>
      <input type="submit" class="btn btn-default login-button center-block" disabled = "disabled" value="Register">
   </form>
 </div>
</div>